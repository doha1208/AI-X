# development, test 외에는 32자 이상 무작위 값을 반드시 사용한다.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DATABASE_URL=sqlite:///./app.db
# openapi.sk.com 에서 발급받는 Tmap 보행자 경로안내 API 키 (없으면 직선 샘플링으로 자동 폴백)
TMAP_APP_KEY=
# data.go.kr 전국보안등정보표준데이터 OpenAPI 인증키
SECURITY_LIGHT_API_KEY=
# Kakao Developers REST API 키 (좌표→행정동 변환용)
KAKAO_REST_API_KEY=
# 점수 프로필 초안을 관리할 이메일 목록. 쉼표로 구분하며 비워 두면 관리자 API를 모두 거부한다.
ADMIN_EMAILS=
# 콤마로 구분한 허용 origin (기본: 로컬 프론트만). cloudflared 등으로 외부에 공유할 때
# 프론트 공개 주소를 추가하거나, 테스트 중엔 * 로 전체 허용해도 된다(쿠키 인증 아님).
CORS_ALLOW_ORIGINS=http://localhost:3000
# dong_code 접두사로 조회 범위를 좁힌다. 41=경기도, 11=서울. 비워두면 전체.
REGION_SCOPE_PREFIX=
# 공개 경로 API 보호. 배포 프로세스별 설정이며, 초과 시 429와 Retry-After를 반환한다.
ROUTE_MAX_CONCURRENT=2
ROUTE_IP_REQUESTS_PER_MINUTE=30
ROUTE_IP_BURST=8
ROUTE_USER_REQUESTS_PER_MINUTE=20
ROUTE_USER_BURST=5
ROUTE_REQUEST_MAX_TRACKED_BUCKETS=10000
# 같은 서버의 Caddy만 전달 IP를 신뢰한다. 외부 프록시를 추가할 때만 해당 IP를 추가한다.
TRUSTED_PROXY_IPS=127.0.0.1,::1
