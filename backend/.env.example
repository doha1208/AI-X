SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DATABASE_URL=sqlite:///./app.db
# openapi.sk.com 에서 발급받는 Tmap 보행자 경로안내 API 키 (없으면 직선 샘플링으로 자동 폴백)
TMAP_APP_KEY=
# data.go.kr 전국보안등정보표준데이터 OpenAPI 인증키
SECURITY_LIGHT_API_KEY=
# Kakao Developers REST API 키 (좌표→행정동 변환용)
KAKAO_REST_API_KEY=
